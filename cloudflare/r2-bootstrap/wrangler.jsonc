{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "neuralstock-r2-bootstrap-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // This bridge is intentionally local-only. Do not deploy it.
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },

  "r2_buckets": [
    {
      "binding": "REGISTRY_BUCKET",
      "bucket_name": "neuralstock-public",
      "remote": true
    }
  ]
}
